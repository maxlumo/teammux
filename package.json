{
  "name": "tmux-mobile",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/preflight.mjs web && vite dev",
    "dev:all": "node scripts/dev-stack.mjs",
    "dev:server:watch": "node scripts/preflight.mjs server && bash scripts/dev-server-watch.sh",
    "gateway:update": "node scripts/gateway-update.mjs",
    "build": "vite build",
    "test": "node --test 'src/**/*.test.js' 'src/**/*.test.ts' 'scripts/**/*.test.js' 'scripts/**/*.test.ts'",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/preflight.mjs dev && tauri dev",
    "tauri:dev:release": "node scripts/preflight.mjs dev && tauri dev --release",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "build:server": "vite build && cargo build --manifest-path src-tauri/Cargo.toml --no-default-features --features embed-ui --release --bins",
    "dev:server": "node scripts/preflight.mjs server && cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --release --bin server",
    "test:rust": "node scripts/test-rust.mjs",
    "test:e2e:docker": "node scripts/e2e-docker.mjs",
    "build:all": "npm run build && npm run tauri:build && npx tauri android build --target aarch64 --apk",
    "build:mac": "tauri build --features embed-ui",
    "build:android": "npx tauri android build --target aarch64 --apk && node scripts/preflight.mjs android-apk"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2.10.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.0.1",
    "jsdom": "30.0.1",
    "svelte": "^5",
    "svelte-check": "4.7.3",
    "typescript": "5.9.3",
    "vite": "^6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-barcode-scanner": "2.4.4",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.33",
    "marked": "^17.0.3",
    "mermaid": "^11.12.3",
    "pdfjs-dist": "^5.4.624",
    "qr": "0.7.2"
  }
}
