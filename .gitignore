# macOS AppleDouble resource-fork sidecars (common on network filesystems)
._*
/src-tauri/target
/target
/dist
/node_modules
# Vite's dep pre-bundle cache, per checkout and OUTSIDE node_modules (board #464)
/.vite
/temp
temp/
# Symlink to the Android gradle build cache (created by the android build)
/build
# Convenience symlink to the built APK. Relative, so it stays valid across
# gradle-cache slug changes — it rides on app/build, which the android
# postflight re-points at this checkout (scripts/preflight.mjs).
/tmux-mobile.apk

# Local scratch / not-in-repo assets
/deploy
/plan.md
/example.txt
/tmuxmobile.svg
/icon_macos.png

# Bundled web fonts — generated/downloaded by scripts/fetch-fonts.sh, kept
# out of git (the CJK subset alone is 5 MB). Run that script after cloning.
/public/fonts/

# Crew launcher: Python bytecode cache + any local crew bus state
crew/__pycache__/
*.db
*.db-wal
*.db-shm

# Project uses npm; stray pnpm lockfile/workspace files would create a
# dual-package-manager conflict (pnpm auto-creates the workspace file when
# invoked directly, e.g. pnpm run tauri:dev)
/pnpm-lock.yaml
/pnpm-workspace.yaml
# Backup left by a git history filter/rewrite — keep locally, never commit
/.git.backup-before-filter/

# Android release signing: the keystore and its passwords live ONLY in
# gen/android/key.properties (see docs/conventions/development.md).
/src-tauri/gen/android/keystore.jks
/src-tauri/gen/android/*.jks
/src-tauri/gen/android/key.properties

# Regenerated by tauri-build on every build; tracking them churned 9 commits.
/src-tauri/gen/schemas/

# Agent task worktrees: <repo>/worktree/<agent>-<task> (owner, 2026-10-10;
# docs/conventions/development.md § Agent worktree isolation). Ignored, so the
# launch checkout's status stays clean and `git add -A` there can never stage
# one as an embedded repository.
/worktree/
# Generated agent homes and local tool state — never project memory.
/.tmm/
/.kiro/
/.playwright-mcp/
# Recorded demo GIFs (15 MB); never committed by standing instruction.
/agent-team-page/
# NFS silly-rename leftovers from files deleted while open.
.nfs.*
/.claude/
